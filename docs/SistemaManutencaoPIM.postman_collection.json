        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/ocorrencias?busca=liga",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Filtro encontra ocorrencia criada\", () => { pm.expect(pm.response.json().some(x => x.id === Number(pm.collectionVariables.get(\"ocorrenciaId\")))).to.eql(true); });"
            ]
          }
        }
      ]
    }
  ],

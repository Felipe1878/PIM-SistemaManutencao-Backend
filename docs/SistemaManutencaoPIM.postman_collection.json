{
  "info": {
    "name": "PIM - Sistema de Manutencao API - fluxo demonstracao",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Executar em ordem. Configure adminSenha e verifique a API. IDs são capturados automaticamente."
  },
  "item": [
    {
      "name": "01 - Login admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"senha\": \"{{adminSenha}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) pm.collectionVariables.set(\"token\", pm.response.json().token);",
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"JWT recebido\", () => pm.expect(pm.response.json().token).to.be.a(\"string\").and.not.empty);"
            ]
          }
        }
      ]
    },

          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Registro da manutencao\", () => { const body = pm.response.json(); const enviado = JSON.parse(pm.request.body.raw); [\"diagnostico\", \"servicoRealizado\", \"observacoes\"].forEach(k => pm.expect(body[k]).to.eql(enviado[k].trim())); });"
            ]
          }
        }
      ]
    },
    {
      "name": "14 - Concluir OS",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/ordens-servico/{{osId}}/concluir",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"dataConclusao\": \"2026-10-20T11:00:00Z\",\n  \"problemaResolvido\": true\n}"
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Estado esperado\", () => { pm.expect(pm.response.json().status).to.eql(\"Concluida\"); });",
              "pm.test(\"OS correta\", () => { pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"osId\"))); });",
              "pm.test(\"Resultado e cronologia UTC\", () => { const body = pm.response.json(); pm.expect(body.problemaResolvido).to.eql(true); pm.expect(body.dataInicio).to.match(/Z$/); pm.expect(body.dataConclusao).to.match(/Z$/); pm.expect(Date.parse(body.dataConclusao)).to.be.at.least(Date.parse(body.dataInicio)); });",
              "pm.sendRequest({",
              "  url: pm.variables.replaceIn(\"{{baseUrl}}/api/ordens-servico/{{osId}}\"),",
              "  method: \"GET\", header: { Authorization: \"Bearer \" + pm.collectionVariables.get(\"token\") }",
              "}, (erro, resposta) => {",
              "  pm.test(\"OS persistida e textos preservados apos concluir\", () => {",
              "    pm.expect(erro).to.equal(null);",
              "    pm.expect(resposta.code).to.eql(200);",
              "    const os = resposta.json();",
              "    pm.expect(os.id).to.eql(Number(pm.collectionVariables.get(\"osId\")));",
              "    pm.expect(os.status).to.eql(\"Concluida\");",
              "    pm.expect(os.manutencao.problemaResolvido).to.eql(true);",
              "    pm.expect(os.manutencao.diagnostico).to.eql(\"Fiação danificada no motor\");",
              "    pm.expect(os.manutencao.servicoRealizado).to.eql(\"Substituicao da fiacao\");",
              "    pm.expect(os.manutencao.observacoes).to.eql(\"Teste do motor realizado\");",
              "  });",
              "});"
            ]
          }
        }
      ]
    },

        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code < 300) pm.collectionVariables.set(\"setorId\", pm.response.json().id);"
            ],
            "type": "text/javascript"
          }
        }

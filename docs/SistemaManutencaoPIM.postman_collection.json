    {
      "name": "13 - Registrar manutenção",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/ordens-servico/{{osId}}/manutencao",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"diagnostico\": \"Fiação danificada no motor\",\n  \"servicoRealizado\": \"Substituicao da fiacao\",\n  \"observacoes\": \"Teste do motor realizado\"\n}"
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
